# Caddy do servidor (usado pelo docker-compose.yml do portal).
#
# Cada solucao tem um bloco com a porta publica (igual a "porta_host" do manifesto),
# o id dela e o endereco interno: <nome do container>:<porta_container>.
# O container se chama "log20-<id>" e esta na rede interna "log20".
#
# Ao publicar uma solucao nova: copie um bloco, ajuste os tres valores, abra a porta em
# docker-compose.yml (servico caddy) e rode:  docker compose up -d caddy

(solucao) {
	# Antes de cada pedido, pergunta ao portal se a pessoa esta logada e tem acesso.
	forward_auth portal:8000 {
		uri /api/auth/verificar?solucao={args[0]}
		copy_headers X-Portal-Usuario
	}
	reverse_proxy {args[1]}

	# Solucao parada ou ainda nao instalada: pagina simples com link de volta ao portal (porta 8000).
	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond <<HTML
			<!doctype html><html lang="pt-BR"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1"><title>Sistema fora do ar</title></head>
			<body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#eef2f3;color:#12262e;font:16px/1.55 'Segoe UI',system-ui,sans-serif">
			<main style="max-width:420px;margin:24px;padding:28px;background:#fff;border:1px solid #d5dee1;border-top:5px solid #003a4d;border-radius:10px">
			<h1 style="margin:0 0 8px;font-size:22px">Sistema fora do ar</h1>
			<p>Este sistema não está disponível agora. Tente de novo em alguns minutos ou avise o administrador do portal.</p>
			<a href="http://{http.request.host}:8000/" style="display:inline-block;margin-top:16px;padding:10px 16px;border-radius:6px;background:#003a4d;color:#fff;text-decoration:none;font-weight:600">Ir para o Portal de Soluções</a>
			</main></body></html>
			HTML 503
	}
}

:8101 {
	import solucao central-colaborador log20-central-colaborador:4000
}

:8102 {
	import solucao central-colaborador-homologacao log20-central-colaborador-homologacao:4000
}
