# Configuracao do portal no servidor. Copie para .env (cp variaveis.exemplo .env) e ajuste.
# O script deploy/preparar-vm.sh cria o .env sozinho, com o IP da maquina.

# Endereco da maquina como os usuarios a acessam (sem porta).
# As solucoes ficam em <PORTAL_URL_BASE>:<porta da solucao>, ex.: http://192.168.0.10:8101
PORTAL_URL_BASE=http://192.168.0.10

# Endereco do proprio portal. Quem tenta abrir uma solucao sem login e mandado para ca.
PORTAL_URL_PUBLICA=http://192.168.0.10:8000

# Token de LEITURA do GitHub para o portal clonar repositorios privados das solucoes.
# Crie em github.com -> Settings -> Developer settings -> Fine-grained tokens, com acesso
# "Contents: Read-only" aos repositorios das solucoes. Deixe vazio se forem publicos.
PORTAL_GIT_TOKEN=

# Senha do administrador do PostgreSQL do servidor (servico "postgres" do docker-compose).
# Os scripts de deploy geram uma aleatoria. Ninguem precisa digita-la: o portal cria o banco
# de cada solucao sozinho. So vale na primeira subida do banco; trocar depois nao muda nada.
PORTAL_POSTGRES_SENHA=

# ---- Supabase das solucoes ([supabase] no manifesto) ----
# Cada solucao com [supabase] ganha um Supabase proprio, criado pelo portal no Iniciar; nada a
# configurar aqui. Opcional: e-mail do login (confirmacao, "esqueci a senha"), igual para todos.
# Sem SMTP, a confirmacao de e-mail e automatica.
# SUPABASE_SMTP_SERVIDOR=smtp.empresa.com.br
# SUPABASE_SMTP_PORTA=587
# SUPABASE_SMTP_USUARIO=...
# SUPABASE_SMTP_SENHA=...
# SUPABASE_SMTP_REMETENTE=portal@empresa.com.br

# ---- Limites e uso (tela Uso) ----
# Limite padrao de cada solucao (o manifesto e a tela Uso mudam por solucao). 0 = sem limite.
# PORTAL_LIMITE_MEMORIA=1g
# PORTAL_LIMITE_CPUS=1
# PORTAL_LIMITE_PROCESSOS=1024
# Coleta do painel de uso: a cada quantos segundos e quantos dias guardar.
# PORTAL_USO_INTERVALO=60
# PORTAL_USO_DIAS=7

# ---- Backup (tela Backups) ----
# Pasta dos backups nesta maquina. Padrao: a pasta backups/ dentro do portal. Melhor em outro
# disco, se houver (ex.: /mnt/backup/portal).
# PORTAL_BACKUP_PASTA_HOST=/mnt/backup/portal
# Segunda copia de cada backup, ex.: uma pasta da rede montada na VM (/etc/fstab, cifs).
# Sem esta linha, nao ha segunda copia. Uma copia fora da VM protege contra perder a VM inteira.
# PORTAL_BACKUP_COPIA_HOST=/mnt/rede/backups-portal
# Padroes da tela Backups (o que for salvo na tela vale mais que isto):
# PORTAL_BACKUP_ATIVO=sim
# PORTAL_BACKUP_HORARIOS=02:30
# PORTAL_BACKUP_MANTER_DIARIOS=14
# PORTAL_BACKUP_MANTER_SEMANAIS=8
# PORTAL_BACKUP_MANTER_MENSAIS=6
# PORTAL_BACKUP_MANTER_AVULSOS=10
# PORTAL_BACKUP_ESPACO_MINIMO_GB=2
# PORTAL_BACKUP_WEBHOOK=https://...      (recebe {"text": "..."} quando um backup falha)
# Tamanho maximo de um arquivo enviado em Backups > Importar arquivo (GB):
# PORTAL_IMPORTACAO_MAX_GB=10
# Backup automatico antes de cada deploy/atualizar.sh (nao recomendado desligar):
# PORTAL_BACKUP_ANTES_DE_ATUALIZAR=sim

# Login vence depois de tantas horas SEM USO (usar o portal ou um sistema renova; maximo 30 dias).
PORTAL_SESSAO_HORAS=12

# ---- HTTPS com certificado proprio: um nome com portas (README, "HTTPS com certificado proprio") ----
# O jeito facil: bash deploy/ligar-https.sh portal.log20.com.br certificado.pfx (ajusta estas linhas).
# Arquivos em dados/certificados/certificado.pem e chave.pem (sem senha). O cookie seguro e o
# PORTAL_PROXIES=* passam a valer sozinhos com https:// no PORTAL_URL_BASE.
# PORTAL_URL_BASE=https://portal.log20.com.br
# PORTAL_URL_PUBLICA=https://portal.log20.com.br
# PORTAL_BIND_PORTAL=127.0.0.1
# Se a VM ja usa 443 ou 80 para outra coisa:
# PORTAL_PORTA_HTTPS=443
# PORTAL_PORTA_HTTP=80

# ---- Alternativa: um subdominio por sistema (veja deploy/Caddyfile.exemplo) ----
# PORTAL_COOKIE_SEGURO=true
# PORTAL_URL_PUBLICA=https://portal.log20.com.br
# PORTAL_COOKIE_DOMINIO=.log20.com.br
# PORTAL_PROXIES=*
